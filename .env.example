# All optional — the defaults below are what the app uses if nothing is set.
# Copy to `.env.local` to override.

# PRNG seed for the simulated stream. The same seed always replays the same
# history, so a demo is reproducible.
SIM_SEED=42

# Average requests per minute, before the diurnal traffic curve is applied.
# Raise it to demo the dashboard at a larger scale.
SIM_RATE_PER_MIN=8

# How much history the store keeps. Must be >= the largest selectable window
# (7d = 168h); anything older is pruned on refresh.
SIM_RETENTION_HOURS=168

# Where the analytics store lives. ":memory:" rebuilds on boot, which is what
# you want on serverless. Point it at a file to persist between restarts —
# `npm run seed` writes data/events.duckdb.
DUCKDB_PATH=:memory:
